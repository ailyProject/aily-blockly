{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "serial-monitor-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/serial-monitor-app",
      "sourceRoot": "projects/serial-monitor-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/serial-monitor-app",
            "index": "projects/serial-monitor-app/src/index.html",
            "browser": "projects/serial-monitor-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/serial-monitor-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/serial-monitor-app/src/favicon.ico",
              "projects/serial-monitor-app/src/assets"
            ],
            "styles": [
              "projects/serial-monitor-app/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "serial-monitor-app:build:production"
            },
            "development": {
              "buildTarget": "serial-monitor-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
