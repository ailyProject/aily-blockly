{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out-tsc/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"erpc#build": {
			"outputs": ["dist/**"],
			"cache": true
		},
		"shared#build": {
			"outputs": ["dist/**"],
			"cache": true
		},
		"core#build": {
			"outputs": ["dist/**"],
			"cache": true
		},
		"deps": {
			"dependsOn": ["erpc#build", "shared#build", "core#build"]
		},
		"ui#build": {
			"dependsOn": ["deps"],
			"outputs": ["dist/**"]
		},
		"desktop#pack:mac": {
			"dependsOn": ["build"],
			"outputs": ["dist/**", "../../release/desktop-mac/**"]
		},
		"desktop#pack:win": {
			"dependsOn": ["build"],
			"outputs": ["dist/**", "../../release/desktop-win/**"]
		}
	}
}
