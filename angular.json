{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "aily-blockly": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/aily-blockly",
            "preserveSymlinks": true,
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": [
              "@codingame/monaco-vscode-api",
              "vscode",
              "monaco-editor",
              "@codingame/monaco-vscode-base-service-override",
              "@codingame/monaco-vscode-extensions-service-override",
              "@codingame/monaco-vscode-rollup-vsix-plugin"
            ],
            "loader": {
              ".ttf": "file",
              ".png": "file",
              ".jpg": "file",
              ".jpeg": "file",
              ".gif": "file",
              ".svg": "file",
              ".woff": "file",
              ".woff2": "file",
              ".eot": "file"
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/blockly/media/",
                "output": "blockly/media"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@codingame/monaco-vscode-theme-defaults-default-extension/resources",
                "output": "vscode/theme-resources"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/animate.css/animate.min.css",
              "node_modules/loaders.css/loaders.min.css",
              "node_modules/ng-zorro-antd/ng-zorro-antd.dark.css",
              "node_modules/ng-zorro-antd/resizable/style/index.less",
              "node_modules/ng-zorro-antd/code-editor/style/index.css",
              "node_modules/angular2-draggable/css/resizable.min.css",
              "node_modules/@xterm/xterm/css/xterm.css",
              "node_modules/cropperjs/dist/cropper.css"
            ],
            "scripts": [
              "node_modules/pinyin-pro/dist/index.js"
            ],
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "aily-blockly:build:production"
            },
            "development": {
              "buildTarget": "aily-blockly:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "./node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "webWorkerTsConfig": "tsconfig.worker.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "6dd2f669-1830-4691-861c-24fdf85dccfc"
  }
}