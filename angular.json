{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "aily-blockly": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/aily-blockly",
            "preserveSymlinks": false,
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "*/i18n/*.json",
                "input": "src/app/tools",
                "output": "tools"
              },
              {
                "glob": "**/*",
                "input": "node_modules/blockly/media/",
                "output": "blockly/media"
              },
              {
                "glob": "native-candidate.js",
                "input": ".generated/blockly-runtime",
                "output": "blockly/runtime"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "/assets/vs"
              },
              {
                "glob": "ng-zorro-antd.dark.css",
                "input": "node_modules/ng-zorro-antd",
                "output": "/"
              },
              {
                "glob": "ng-zorro-antd.min.css",
                "input": "node_modules/ng-zorro-antd",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/animate.css/animate.min.css",
              "node_modules/loaders.css/loaders.min.css",
              "node_modules/ng-zorro-antd/ng-zorro-antd.dark.css",
              "node_modules/ng-zorro-antd/resizable/style/index.less",
              "node_modules/ng-zorro-antd/code-editor/style/index.css",
              "node_modules/angular2-draggable/css/resizable.min.css",
              "node_modules/@xterm/xterm/css/xterm.css",
              "node_modules/cropperjs/dist/cropper.css"
            ],
            "scripts": [],
            "externalDependencies": [
              "node:child_process",
              "node:readline"
            ],
            "allowedCommonJsDependencies": [
              "@blockly/block-dynamic-connection",
              "@blockly/field-colour-hsv-sliders",
              "@blockly/workspace-minimap",
              "@braintree/sanitize-url",
              "@xterm/addon-clipboard",
              "@xterm/addon-fit",
              "@xterm/xterm",
              "ajv",
              "atob-lite",
              "base64-js",
              "blockly/blocks",
              "blockly/core",
              "buffer",
              "cropperjs",
              "cytoscape-cose-bilkent",
              "cytoscape-fcose",
              "dayjs",
              "dayjs/plugin/advancedFormat.js",
              "dayjs/plugin/customParseFormat.js",
              "dayjs/plugin/duration.js",
              "dayjs/plugin/isoWeek.js",
              "dragselect",
              "escape-html",
              "fast-deep-equal",
              "fast-uri",
              "json-schema-traverse",
              "semver",
              "spark-md5",
              "vscode-languageserver-protocol",
              "vscode-jsonrpc"
            ],
            "loader": {
              ".md": "text"
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "7MB",
                  "maximumError": "8MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "50kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "aily-blockly:build:production"
            },
            "development": {
              "buildTarget": "aily-blockly:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "inlineStyleLanguage": "scss",
            "preserveSymlinks": false,
            "builderMode": "application",
            "include": [
              "**/*.spec.ts"
            ],
            "assets": [
              {
                "glob": "native-candidate.js",
                "input": ".generated/blockly-runtime",
                "output": "blockly/runtime"
              }
            ],
            "styles": [],
            "scripts": []
          },
          "configurations": {
            "abs-sync": {
              "tsConfig": "tsconfig.abs-sync.spec.json",
              "include": [
                "src/app/integrations/blockly/board-config-operation.spec.ts",
                "src/app/integrations/blockly/board-switch-operation.spec.ts",
                "src/app/integrations/blockly/project-mode-tool-routing.spec.ts",
                "src/app/services/domains/project/project-board-switch.spec.ts",
                "src/app/services/domains/project/project-lifecycle-gate.spec.ts",
                "src/app/services/domains/project/project-lifecycle-operation.spec.ts",
                "src/app/editors/blockly-editor/project-board-reload.spec.ts",
                "src/app/services/domains/project/project-mode.spec.ts",
                "src/app/integrations/blockly/abs/**/*.spec.ts",
                "src/app/editors/blockly-editor/services/builder.service.spec.ts",
                "src/app/editors/blockly-editor/services/blockly-generator-runtime.service.spec.ts",
                "src/app/services/shared/abs/**/*.spec.ts",
                "src/app/services/domains/project/project-data/project-data-abs.spec.ts",
                "src/app/services/domains/project/project-data/project-data-generic-values.spec.ts",
                "src/app/services/domains/project/project-data/project-data-normalization.spec.ts",
                "src/app/services/domains/project/project-save-as.spec.ts",
                "src/app/services/domains/project/project-block-field-updates.spec.ts"
              ]
            },
            "abs-project-load": {
              "tsConfig": "tsconfig.abs-sync.spec.json",
              "preserveSymlinks": false,
              "include": [
                "src/app/editors/blockly-editor/blockly-editor-load.spec.ts",
                "src/app/pages/playground/example-list/example-list-import.spec.ts"
              ]
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "6dd2f669-1830-4691-861c-24fdf85dccfc"
  }
}
