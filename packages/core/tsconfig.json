{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"skipLibCheck": true,
		"lib": ["ESNEXT", "DOM"],
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"strict": true,
		"rootDir": "..",
		"outDir": "dist",
		"isolatedModules": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": "..",
		"paths": {
			"@shared": ["./shared/index.ts"]
		},
		"types": ["node"]
	},
	"include": ["agent", "api", "rpc", "hardware", "project", "metadata", "document", "abi", "abs", "build"]
}
