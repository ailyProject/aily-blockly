{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"skipLibCheck": true,
		"lib": ["ESNEXT", "DOM"],
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"strict": true,
		"rootDir": "..",
		"outDir": "dist",
		"isolatedModules": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@core/*": ["../core/src/*"],
			"shared": ["../shared/src/index.ts"]
		},
		"types": ["node"]
	},
	"include": ["src"]
}
