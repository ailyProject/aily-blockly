		"skipLibCheck": true,
		"isolatedModules": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "ES2022",
		"module": "preserve",
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
