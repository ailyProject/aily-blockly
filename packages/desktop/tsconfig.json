{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"skipLibCheck": true,
		"lib": ["ESNEXT", "DOM"],
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"strict": true,
		"rootDir": ".",
		"outDir": "dist",
		"isolatedModules": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"shared": ["../shared/dist/index.d.ts"],
			"core/*": ["../core/dist/*/index.d.ts"],
			"erpc/main": ["../erpc/dist/main/index.d.ts"]
		},
		"ignoreDeprecations": "6.0",
		"types": ["node"]
	},
	"include": ["src"]
}
