{
	"name": "desktop",
	"productName": "Aily Blockly",
	"version": "0.0.0",
	"description": "Thin Electron shell for Aily Blockly",
	"type": "module",
	"main": "dist/main/index.cjs",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/main/index.cjs"
		},
		"./preload": {
			"types": "./dist/src/preload/index.d.ts",
			"default": "./dist/preload/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "node ./scripts/dev.mjs",
		"main:dev": "rslib build --watch",
		"watch": "node ./scripts/dev-runner.mjs",
		"start": "node ./scripts/start-electron.mjs",
		"shell": "electron .",
		"build": "rslib build",
		"pack:mac": "pnpm run build && node ../../scripts/trim_desktop_release.mjs --platform mac",
		"pack:win": "pnpm run build && node ../../scripts/trim_desktop_release.mjs --platform win"
	},
	"dependencies": {
		"@lydell/node-pty": "^1.1.0",
		"@trpc/server": "catalog:",
		"core": "workspace:*",
		"electron": "catalog:",
		"erpc": "workspace:*",
		"shared": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rslib/core": "catalog:",
		"@types/node": "catalog:",
		"@types/watchpack": "catalog:",
		"deepmerge-ts": "catalog:",
		"typescript": "catalog:",
		"watchpack": "catalog:"
	}
}
