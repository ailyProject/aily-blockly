{
  "name": "aily-blockly-tests",
  "private": true,
  "scripts": {
    "test": "cd .. && node scripts/run-angular.cjs test",
    "test:unit:ci": "cd .. && node scripts/run-angular.cjs test --watch=false --browsers=ChromeHeadless",
    "test:cloud-build": "node scripts/run-cloud-build.cjs",
    "test:build-workspace": "cd .. && node --test tests/build-workspace-recovery.test.cjs tests/system-boot-id.test.cjs tests/package-build-lock-runtime.test.cjs child/scripts/build-workspace-lease.test.js child/scripts/build-workspace-publication.test.js tests/electron/build-workspace-supervisor.test.js tests/electron/cloud-build-reuse.test.js child/scripts/build-source-capture.test.js child/scripts/blockly-upload-state.test.js",
    "test:blockly-recovery": "cd .. && node scripts/run-angular.cjs test --watch=false --browsers=ChromeHeadless --ts-config=tests/tsconfig.blockly-recovery.spec.json --include=../tests/blockly-interaction-recovery.spec.ts --include=../tests/blockly-pointer-boundary.spec.ts --include=../tests/blockly-viewport-focus.spec.ts --include=src/app/editors/blockly-editor/utils/blockly-drag-layer.spec.ts --include=src/app/editors/blockly-editor/utils/blockly-multiselect-v13.spec.ts --include=src/app/services/domains/project/project-lifecycle-operation.spec.ts --include=src/app/editors/blockly-editor/components/dev-tool/dev-tool-coder.spec.ts",
    "test:abs-sync": "cd .. && node scripts/run-angular.cjs test --configuration=abs-sync --watch=false --browsers=ChromeHeadless",
    "guard:aily-chat-mainline": "cd .. && node tests/architecture/guard-aily-chat-mainline.js",
    "architecture:services": "cd .. && node tests/architecture/check-angular-service-architecture.mjs",
    "architecture:services:inventory": "cd .. && node tests/architecture/check-angular-service-architecture.mjs --inventory",
    "smoke:simulator-gateway": "cd .. && node tests/integration/smoke-simulator-gateway-bridge.mjs",
    "smoke:simulator-gateway-crash": "cd .. && node tests/integration/smoke-simulator-gateway-crash.mjs",
    "test:coder-board-menu": "cd .. && node scripts/run-angular.cjs test --configuration=coder-board-menu --watch=false --browsers=ChromeHeadless"
  }
}
