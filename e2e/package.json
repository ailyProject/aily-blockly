{
  "name": "aily-blockly-e2e",
  "private": true,
  "scripts": {
    "test:unsaved-close": "cd .. && cross-env AILY_E2E_DEV_URL=http://localhost:4200 playwright test -c e2e/unsaved-close.config.ts",
    "test:chat-attachments": "cd .. && node ./e2e/scripts/run-chat-attachments.mjs",
    "test": "cd .. && node ./e2e/scripts/run-e2e.mjs test",
    "test:ui": "cd .. && node ./e2e/scripts/run-e2e.mjs ui",
    "test:headed": "cd .. && node ./e2e/scripts/run-e2e.mjs headed",
    "test:fast": "cd .. && node ./e2e/scripts/run-e2e.mjs fast",
    "test:cloud-build": "cd .. && playwright test -c e2e/cloud-build.config.ts",
    "report": "cd .. && node ./e2e/scripts/run-e2e.mjs report",
    "prepare:simulator-debug": "cd .. && node ./e2e/scripts/prepare-simulator-debug-e2e.mjs",
    "test:simulator-debug": "cd .. && node ./e2e/scripts/run-simulator-debug-e2e.mjs",
    "test:serial-product": "cd .. && node ./e2e/electron/subapp-product.acceptance.mjs",
    "test:serial-owner-crash": "cd .. && node ./e2e/electron/subapp-owner-crash.acceptance.mjs",
    "test:abs-agent-recovery": "cd .. && node ./e2e/electron/abs-agent-recovery.acceptance.mjs",
    "validate:simulator-debug": "cd .. && node ./e2e/scripts/validate-simulator-debug-e2e-report.mjs",
    "perf:blockly:prepare": "cd .. && node e2e/performance/scripts/prepare-blockly-performance.cjs",
    "perf:blockly:serve": "cd .. && node e2e/performance/scripts/serve-blockly-performance.cjs",
    "perf:blockly:test": "cd .. && playwright test -c e2e/performance.config.ts",
    "perf:blockly:real:fixture": "cd .. && node e2e/performance/scripts/prepare-blockly-real-fixture.cjs",
    "perf:blockly:real:prepare": "cd .. && node e2e/performance/scripts/prepare-blockly-real-performance.cjs",
    "perf:blockly:real:test": "cd .. && playwright test -c e2e/real-performance.config.ts",
    "test:project-save-as": "cd .. && node ./e2e/scripts/run-e2e.mjs test --config e2e/project-save-as.config.ts"
  }
}
